{
  "name": "sentinel",
  "version": "0.1.0",
  "exports": "./src/contracts/mod.ts",
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check src/contracts/mod.ts src/state/mod.ts src/budget/mod.ts src/github/mod.ts src/adapters/gateway/mod.ts src/replay/mod.ts src/repair/mod.ts src/release/mod.ts src/host/github.ts src/host/host.ts src/host/local.ts src/host/providers.ts src/host/repair.ts src/host/release.ts src/host/run.ts src/host/actions-supervisor.ts src/host/actions.ts src/host/hosted-runtime.ts src/host/hosted-cooldown.ts src/main.ts src/release-main.ts src/observe-main.ts",
    "test": "deno test --allow-read=.,/usr,/bin,$(deno eval 'console.log(Deno.execPath())') --allow-run --allow-write --allow-env=PATH,NODE_V8_COVERAGE tests/contracts/ tests/state/ tests/budget/ tests/github/ tests/host/ tests/adapters/gateway/ tests/replay/ tests/repair/ tests/release/ tests/integration/",
    "test:integration": "deno test --allow-read=. --allow-run=git --allow-write --allow-env=PATH tests/integration/",
    "test:local": "deno run --allow-env=PATH --allow-run=deno --allow-run=git --allow-write test-local.ts",
    "repair:run": "deno run --allow-read --allow-write --allow-run --allow-net=api.github.com,127.0.0.1:8000 --allow-env=HOME,PATH,GITHUB_TOKEN,SENTINEL_SUPERVISOR_TOKEN,UOS_AI_TOKEN,NODE_V8_COVERAGE src/main.ts",
    "repair:actions": "deno run --allow-read --allow-write --allow-run --allow-net=\"api.github.com,*.blob.core.windows.net\" --allow-env=HOME,PATH,GITHUB_TOKEN,SENTINEL_SUPERVISOR_TOKEN,UOS_AI_TOKEN,SENTINEL_MODEL_BASE_URL,SENTINEL_MODEL_ID,SENTINEL_MODEL_FALLBACK,SENTINEL_DEEPSEEK_API_KEY,NODE_V8_COVERAGE,GITHUB_RUN_ID,GITHUB_RUN_ATTEMPT,GITHUB_REPOSITORY,GITHUB_REF,GITHUB_SHA,GITHUB_WORKFLOW_SHA,GITHUB_WORKFLOW_REF,GITHUB_JOB src/host/actions.ts",
    "release:run": "deno run --allow-read --allow-write --allow-run=git --allow-env=PATH src/release-main.ts",
    "observe:run": "deno run --allow-read=. --allow-write=. --allow-net=ai.ubq.fi --allow-env=SENTINEL_GATEWAY_AUTH_JSON,SENTINEL_REPLAY_KEY_B64 src/observe-main.ts",
    "supervisor:run": "deno run --allow-read --allow-write --allow-run --allow-net=\"api.github.com,*.blob.core.windows.net\" --allow-env=HOME,PATH,GITHUB_TOKEN,SENTINEL_SUPERVISOR_TOKEN,SENTINEL_MODEL_BASE_URL,SENTINEL_MODEL_ID,SENTINEL_MODEL_FALLBACK,SENTINEL_DEEPSEEK_API_KEY,GITHUB_OUTPUT,NODE_V8_COVERAGE,GITHUB_RUN_ID,GITHUB_RUN_ATTEMPT,GITHUB_REPOSITORY,GITHUB_REF,GITHUB_SHA,GITHUB_WORKFLOW_SHA,GITHUB_WORKFLOW_REF,GITHUB_JOB src/host/actions-supervisor.ts"
  },
  "fmt": {
    "include": [
      "src/",
      "tests/",
      "test-local.ts",
      "docs/contracts.md",
      "deno.json"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "tests/",
      "test-local.ts"
    ]
  },
  "compilerOptions": {
    "strict": true
  }
}
