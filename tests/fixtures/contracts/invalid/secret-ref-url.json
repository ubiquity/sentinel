{
  "version": "v1",
  "kind": "repository_config",
  "repository": {
    "owner": "ubiquity",
    "name": "ai.ubq.fi",
    "installationId": 12345
  },
  "baseBranch": "development",
  "adapter": {
    "kind": "gateway",
    "baseUrl": "https://ai.ubq.fi"
  },
  "commands": {
    "replay": "replay_capture",
    "test": "test_ci"
  },
  "protectedPaths": [
    "src/",
    "deno.json",
    ".github/workflows/"
  ],
  "build": {
    "projectId": "ai-ubq-fi-prod",
    "acceptance": {
      "healthPath": "/health",
      "metricsPath": "/admin/sentinel/metrics",
      "managedBodyMarker": "sentinel-managed",
      "managedHeaders": [
        {
          "name": "x-managed-by",
          "value": "sentinel"
        }
      ],
      "domain": null
    }
  },
  "liveStartLimits": {
    "perHour": 4,
    "perSevenDays": 40
  },
  "sessionBound": {
    "maxDurationMs": 7200000,
    "maxOutputChars": 400000
  },
  "retention": {
    "evidenceMaxAgeMs": 604800000,
    "evidenceMaxBytes": 4194304
  },
  "stabilityPolicy": {
    "windowMs": 1800000,
    "sampleIntervalMs": 30000,
    "minSamples": 60,
    "baselineWindowMs": 86400000,
    "baselineMinSamples": 500,
    "thresholds": [
      {
        "metric": "five_xx_rate",
        "maxRate": 0.02,
        "maxIncrease": 0.01
      },
      {
        "metric": "timeout_rate",
        "maxRate": 0.01,
        "maxIncrease": 0.01
      },
      {
        "metric": "stream_failure_rate",
        "maxRate": 0.01,
        "maxIncrease": 0.01
      }
    ],
    "minRequests": 10
  },
  "commandRegistry": {
    "version": "v1",
    "commands": {
      "replay_capture": {
        "executable": "deno",
        "args": [
          "task",
          "replay:capture"
        ],
        "maxDurationMs": 600000,
        "maxOutputBytes": 1048576
      },
      "test_ci": {
        "executable": "deno",
        "args": [
          "task",
          "test-local"
        ],
        "maxDurationMs": 1800000,
        "maxOutputBytes": 4194304
      }
    }
  },
  "secretRef": "https://user:pass@example.com/artifact?token=secret"
}
